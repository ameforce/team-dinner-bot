{
    "display_information": {
        "name": "Team Dinner Bot",
        "description": "Team dinner scheduling bot"
    },
    "features": {
        "bot_user": {
            "display_name": "Team Dinner Bot",
            "always_online": true
        },
        "app_home": {
            "home_tab_enabled": false,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false
        },
        "slash_commands": [
            {
                "command": "/회식",
                "description": "회식 일정 설정, 상태 확인, 투표 실행",
                "usage_hint": "[설정|상태|지금|취소]",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "channels:read",
                "commands",
                "groups:read",
                "im:write",
                "users:read",
                "users:read.email"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "member_joined_channel",
                "member_left_channel"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}
