# Team Dinner Bot local configuration

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# App identity
APP_NAME=Team Dinner Bot
APP_SLUG=team-dinner-bot
BOT_DISPLAY_NAME=Team Dinner Bot

# App runtime
DATABASE_URL=sqlite:///./data/team-dinner-bot.db
LOCK_FILE_PATH=./data/team-dinner-bot.lock
DEFAULT_TIMEZONE=Asia/Seoul
DEFAULT_POLL_HOUR=10
DEFAULT_POLL_DURATION_HOURS=24
ENCRYPTION_KEY=

# Optional: enable server-side Google Calendar event creation.
# If GOOGLE_REFRESH_TOKEN is empty, the bot falls back to the assignee DM create link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optional: restrict `회식 지금` / `run-now` to comma-separated Slack user IDs.
ADMIN_USER_IDS=
